rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /courses/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.token.admin == true
                   && request.resource.size < 200 * 1024 * 1024;
    }
  }
}
